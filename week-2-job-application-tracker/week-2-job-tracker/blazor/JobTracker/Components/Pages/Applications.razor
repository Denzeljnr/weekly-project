@page "/"
@using Microsoft.EntityFrameworkCore
@using JobTracker.Data
@using JobTracker.Models
@inject AppDbContext Db

<h1 class="page-title">Applications</h1>
<p class="page-sub">Tracked automatically from your inbox.</p>

<div class="stats-row">
    <div class="stat">
        <span class="stat-value">@applications.Count</span>
        <span class="stat-label">Applied</span>
    </div>
    <div class="stat">
        <span class="stat-value">@applications.Count(a => a.Status == "interview")</span>
        <span class="stat-label">Interview</span>
    </div>
    <div class="stat stat-offer">
        <span class="stat-value">@applications.Count(a => a.Status == "offer")</span>
        <span class="stat-label">Offer</span>
    </div>
    <div class="stat stat-rejected">
        <span class="stat-value">@applications.Count(a => a.Status == "rejected")</span>
        <span class="stat-label">Rejected</span>
    </div>
</div>

@if (staleCount > 0)
{
    <div class="banner">
        <span class="banner-dot"></span>
        @staleCount application@(staleCount == 1 ? "" : "s") gone quiet — worth a follow-up.
    </div>
}

<div class="filter-row">
    @foreach (var f in new[] { "all", "applied", "interview", "offer", "rejected" })
    {
        <button class="filter-btn @(activeFilter == f ? "active" : "")" @onclick="() => SetFilter(f)">
            @(f == "all" ? "All" : char.ToUpper(f[0]) + f[1..])
        </button>
    }
</div>

<div class="board">
    <div class="board-header">
        <span>Company</span>
        <span>Role</span>
        <span>Applied</span>
        <span>Status</span>
        <span>Updated</span>
    </div>

    @foreach (var app in pagedApplications)
    {
        <div class="board-row status-@app.Status">
            <span class="row-bar"></span>
            <div class="cell company">
                @app.Company
                @if (!string.IsNullOrWhiteSpace(app.Summary))
                {
                    <div class="summary">@app.Summary</div>
                }
            </div>
            <span class="cell">@app.Role</span>
            <span class="cell mono">@app.DateApplied</span>
            <span class="cell">
                <span class="status-pill status-@app.Status">
                    <span class="pill-dot"></span>@app.Status
                </span>
            </span>
            <span class="cell mono">@app.LastUpdated.ToString("MMM d")</span>
        </div>
    }

    @if (!pagedApplications.Any())
    {
        <div class="empty-state">No applications match this filter yet.</div>
    }
</div>

@if (totalPages > 1)
{
    <div class="pagination">
        <button class="page-btn" disabled="@(currentPage == 1)" @onclick="() => GoToPage(currentPage - 1)">‹ Prev</button>
        <span class="page-info">Page @currentPage of @totalPages</span>
        <button class="page-btn" disabled="@(currentPage == totalPages)" @onclick="() => GoToPage(currentPage + 1)">Next ›</button>
    </div>
}

<style>
    .page-title {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 2rem;
        margin: 0 0 4px;
    }

    .page-sub {
        color: #9BA5A9;
        margin: 0 0 20px;
        font-size: 0.95rem;
    }

    .stats-row {
        display: flex;
        gap: 24px;
        margin-bottom: 24px;
    }

    .stat {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .stat-value {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 1.6rem;
        color: #EDEAE2;
    }

    .stat-label {
        font-size: 0.78rem;
        color: #6B7579;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .stat-offer .stat-value {
        color: #5B8DBE;
    }

    .stat-rejected .stat-value {
        color: #C4573F;
    }

    .banner {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #241D14;
        color: #E8A33D;
        border: 1px solid #3A2C17;
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 0.92rem;
    }

    .banner-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #E8A33D;
        flex-shrink: 0;
    }

    .filter-row {
        display: flex;
        gap: 8px;
        margin-bottom: 20px;
    }

    .filter-btn {
        background: #1B2328;
        border: 1px solid #232C31;
        color: #9BA5A9;
        padding: 7px 14px;
        border-radius: 999px;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.15s;
        font-family: 'Inter', sans-serif;
    }

        .filter-btn:hover {
            color: #EDEAE2;
            border-color: #3A444A;
        }

        .filter-btn.active {
            background: #241D14;
            color: #E8A33D;
            border-color: #3A2C17;
        }

    .board {
        background: #1B2328;
        border: 1px solid #232C31;
        border-radius: 10px;
        overflow: hidden;
    }

    .board-header, .board-row {
        display: grid;
        grid-template-columns: 1.6fr 1.4fr 1fr 1fr 0.8fr;
        align-items: center;
        gap: 12px;
    }

    .board-header {
        padding: 12px 20px;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #6B7579;
        border-bottom: 1px solid #232C31;
    }

    .board-row {
        position: relative;
        padding: 14px 20px 14px 24px;
        border-bottom: 1px solid #202A2E;
        font-size: 0.92rem;
    }

        .board-row:last-child {
            border-bottom: none;
        }

    .empty-state {
        padding: 32px 20px;
        text-align: center;
        color: #6B7579;
        font-size: 0.9rem;
    }

    .row-bar {
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 3px;
    }

    .status-applied .row-bar {
        background: #E8A33D;
    }

    .status-interview .row-bar {
        background: #6FA287;
    }

    .status-offer .row-bar {
        background: #5B8DBE;
    }

    .status-rejected .row-bar {
        background: #C4573F;
    }

    .cell.company {
        font-weight: 600;
    }

    .cell.mono {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.82rem;
        color: #9BA5A9;
    }

    .summary {
        font-weight: 400;
        font-size: 0.8rem;
        color: #8A9498;
        margin-top: 4px;
        max-width: 340px;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 0.78rem;
        text-transform: capitalize;
    }

    .pill-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }

    .status-pill.status-applied {
        background: #241D14;
        color: #E8A33D;
    }

        .status-pill.status-applied .pill-dot {
            background: #E8A33D;
        }

    .status-pill.status-interview {
        background: #16231C;
        color: #6FA287;
    }

        .status-pill.status-interview .pill-dot {
            background: #6FA287;
        }

    .status-pill.status-offer {
        background: #16202B;
        color: #5B8DBE;
    }

        .status-pill.status-offer .pill-dot {
            background: #5B8DBE;
        }

    .status-pill.status-rejected {
        background: #26160F;
        color: #C4573F;
    }

        .status-pill.status-rejected .pill-dot {
            background: #C4573F;
        }

    .pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        margin-top: 20px;
    }

    .page-btn {
        background: #1B2328;
        border: 1px solid #232C31;
        color: #EDEAE2;
        padding: 7px 16px;
        border-radius: 6px;
        font-size: 0.85rem;
        cursor: pointer;
        font-family: 'Inter', sans-serif;
    }

        .page-btn:disabled {
            opacity: 0.35;
            cursor: default;
        }

        .page-btn:not(:disabled):hover {
            border-color: #3A444A;
        }

    .page-info {
        color: #9BA5A9;
        font-size: 0.85rem;
        font-family: 'IBM Plex Mono', monospace;
    }
</style>

@code {
    private const int PageSize = 10;

    private List<JobApplication> applications = new();
    private int staleCount = 0;
    private string activeFilter = "all";
    private int currentPage = 1;

    private List<JobApplication> FilteredApplications =>
        activeFilter == "all"
            ? applications
            : applications.Where(a => a.Status == activeFilter).ToList();

    private List<JobApplication> pagedApplications =>
        FilteredApplications.Skip((currentPage - 1) * PageSize).Take(PageSize).ToList();

    private int totalPages =>
        (int)Math.Ceiling(FilteredApplications.Count / (double)PageSize);

    protected override async Task OnInitializedAsync()
    {
        applications = await Db.Applications.OrderByDescending(a => a.DateApplied).ToListAsync();
        var cutoff = DateTime.UtcNow.AddDays(-10);
        staleCount = applications.Count(a => a.Status == "applied" && a.LastUpdated < cutoff && !a.NudgeAcknowledged);
    }

    private void SetFilter(string filter)
    {
        activeFilter = filter;
        currentPage = 1;
    }

    private void GoToPage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
    }
}