    {
      "parameters": {
        "jsCode": "const agent = $('parse the Agent response').first().json;;\nconst existingRows = $input.all()\n  .map(item => item.json)\n  .filter(row => row.company); // drops the empty placeholder item when the sheet has no real rows yet\n\nconst statusMap = {\n  application_confirmation: 'applied',\n  interview: 'interview',\n  offer: 'offer',\n  rejected: 'rejected',\n  no_response_but_active: 'applied',\n  unclear: null\n};\nconst newStatus = statusMap[agent.status];\n\nif (!newStatus || !agent.company) {\n  return [{ json: { skip: true } }];\n}\n\n// Fuzzy match, case-insensitive partial — mirrors the Blazor ILIKE behavior\nconst companyLower = agent.company.toLowerCase();\nconst match = existingRows.find(r =>\n  r.company.toLowerCase().includes(companyLower) ||\n  companyLower.includes(r.company.toLowerCase())\n);\n\n// Once an application has a final outcome, don't let any further\n// classification (correct or mistaken) move it backward — mirrors the Blazor fix.\nif (match && (match.status === 'offer' || match.status === 'rejected')) {\n  return [{ json: { skip: true } }];\n}\n\nreturn [{\n  json: {\n    skip: false,\n    company: match ? match.company : agent.company,\n    role: match ? (match.role || agent.role || '') : (agent.role || ''),\n    date_applied: match ? match.date_applied : new Date().toISOString().split('T')[0],\n    status: newStatus,\n    last_updated: new Date().toISOString().split('T')[0],\n    summary: (newStatus === 'rejected' || newStatus === 'offer')\n      ? agent.summary\n      : (match ? match.summary : '')\n  }\n}];"
      },
