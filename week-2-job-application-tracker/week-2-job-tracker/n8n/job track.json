    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\n\nfunction bucketBy(rows, keyFn) {\n  const buckets = {};\n  for (const r of rows) {\n    const key = keyFn(new Date(r.date_applied));\n    buckets[key] ??= { applied: 0, interview: 0, offer: 0, rejected: 0 };\n    if (buckets[key][r.status] !== undefined) buckets[key][r.status]++;\n  }\n  return buckets;\n}\n\nconst weekly = bucketBy(rows, d => {\n  const weekStart = new Date(d);\n  weekStart.setDate(d.getDate() - d.getDay());\n  return weekStart.toISOString().split('T')[0];\n});\n\nconst monthly = bucketBy(rows, d => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`);\n\nreturn [{ json: { weekly, monthly } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        176,
        1344
      ],
      "id": "7c23bdc4-1309-43aa-9a2f-0188211ba3e2",
      "name": "Build Weekly/Monthly Stats"
    },
    {
      "parameters": {
        "jsCode": "const { weekly, monthly } = $input.first().json;\n\nfunction formatSection(title, buckets) {\n  let rows = '';\n  for (const [period, counts] of Object.entries(buckets)) {\n    rows += `\n      <tr>\n        <td style=\"padding:6px 12px;\">${period}</td>\n        <td style=\"padding:6px 12px;\">${counts.applied}</td>\n        <td style=\"padding:6px 12px;\">${counts.interview}</td>\n        <td style=\"padding:6px 12px;\">${counts.offer}</td>\n        <td style=\"padding:6px 12px;\">${counts.rejected}</td>\n      </tr>`;\n  }\n  return `\n    <h3 style=\"margin-bottom:6px;\">${title}</h3>\n    <table style=\"border-collapse:collapse; font-family:sans-serif; font-size:14px;\">\n      <tr style=\"text-align:left; color:#555;\">\n        <th style=\"padding:6px 12px;\">Period</th>\n        <th style=\"padding:6px 12px;\">Applied</th>\n        <th style=\"padding:6px 12px;\">Interview</th>\n        <th style=\"padding:6px 12px;\">Offer</th>\n        <th style=\"padding:6px 12px;\">Rejected</th>\n      </tr>\n      ${rows}\n    </table>`;\n}\n\nconst emailBody = `\n  <div style=\"font-family:sans-serif;\">\n    ${formatSection('This week (last 8 weeks)', weekly)}\n    <br>\n    ${formatSection('By month (last 6 months)', monthly)}\n  </div>\n`;\n\nreturn [{ json: { emailBody } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
