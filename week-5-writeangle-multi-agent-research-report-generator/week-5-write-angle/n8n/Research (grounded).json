        "text": "={{ $json.claims.map(c => `Claim: ${c.claim}\\nSource: ${c.sourceTitle} (${c.sourceUrl})`).join('\\n\\n') }}",
        "options": {
          "systemMessage": "=You are a skeptical fact-checking editor. For each claim, judge whether it is genuinely well-supported by its cited source, based on the source's title and URL alone. Flag anything vague, unsupported, or where the source doesn't obviously match the claim.\n\nRespond ONLY in this exact JSON format, no other text:\n{ \"approved\": true or false, \"issues\": [ { \"description\": \"string\", \"relatedClaim\": \"string\" } ] }\nSet approved to true only if there are no issues."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        512,
        0
      ],
      "id": "d5b5d0a3-2d9c-48a9-aab1-c6380ade16b7",
      "name": "Critic review"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output;\nconst cleaned = raw.replace(/```json|```/g, '').trim();\nlet critique;\ntry { critique = JSON.parse(cleaned); } catch { critique = { approved: true, issues: [] }; }\n\nreturn [{\n  json: {\n    topic: $('Parse research draft').first().json.topic,\n    revisionCount: $('Parse research draft').first().json.revisionCount,\n    claims: $('Parse research draft').first().json.claims,\n    approved: critique.approved,\n    issues: critique.issues || []\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
