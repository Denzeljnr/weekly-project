    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"role\": \"user\",\n      \"parts\": [\n        {\n          \"text\": \"You are a research assistant. Use web search to find real, current information on the given topic. Respond ONLY in this exact JSON format, no other text: { \\\"claims\\\": [ { \\\"claim\\\": \\\"string\\\", \\\"sourceUrl\\\": \\\"string\\\", \\\"sourceTitle\\\": \\\"string\\\" } ] }\\n\\nTopic: {{ $json.Topic }}\\n\\n{{ $json.feedbackText ? 'Address these specific issues from the previous draft: ' + $json.feedbackText : '' }}\"\n        }\n      ]\n    }\n  ],\n  \"tools\": [\n    { \"google_search\": {} }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        112,
        0
      ],
      "id": "174d389b-4e8b-46da-8360-c3ea9e71a0f2",
      "name": "HTTP Request",
      "credentials": {
        "httpQueryAuth": {
          "id": "OlwVxnKRxoMdkuNV",
          "name": "Gemini Query Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.candidates[0].content.parts[0].text;\nconst cleaned = raw.replace(/```json|```/g, '').trim();\nlet parsed;\ntry { parsed = JSON.parse(cleaned); } catch { parsed = { claims: [] }; }\n\nreturn [{\n  json: {\n    topic: $('Initialize state').first().json.Topic,\n    revisionCount: $('Initialize state').first().json.revisionCount,\n    claims: parsed.claims || []\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
