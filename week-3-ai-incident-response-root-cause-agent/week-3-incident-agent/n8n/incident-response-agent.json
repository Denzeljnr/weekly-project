      "parameters": {
        "jsCode": "const raw = $input.first().json.output;\nlet parsed;\ntry {\n  const cleaned = raw.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { summary: 'Parse failed', likely_cause: 'unknown', evidence: '', affected_service: '', recommended_action: 'Manual review needed' };\n}\nreturn [{ json: parsed }];"
      },
