    {
      "parameters": {
        "jsCode": "const alert = $('Loop Over Items').item.json;\n\nconst logs = $('Get logs')\n  .all()\n  .map(i => i.json)\n  .filter(r => r.id !== undefined);\n\nconst deployments = $('Get deployments')\n  .all()\n  .map(i => i.json)\n  .filter(r => r.id !== undefined);\n\nconst dbEvents = $('Get db events')\n  .all()\n  .map(i => i.json)\n  .filter(r => r.id !== undefined);\n\nlet signalTypesPresent = 0;\n\nif (logs.length) signalTypesPresent++;\nif (deployments.length) signalTypesPresent++;\nif (dbEvents.length) signalTypesPresent++;\n\nconst confidence = Math.round((signalTypesPresent / 3) * 100);\n\nconst relatedEvents =\n  logs.length +\n  deployments.length +\n  dbEvents.length;\n\nconst evidenceText = `\nAlert: ${alert.message} (fired at ${alert.fired_at})\nComputed confidence: ${confidence}% (${relatedEvents} related events)\n\nRecent deployments:\n${deployments\n  .map(d => `- ${d.commit_sha} at ${d.deployed_at}: ${d.description}`)\n  .join('\\n') || 'none'}\n\nRecent error logs:\n${logs\n  .map(l => `- ${l.created_at} [${l.endpoint}] ${l.message} (${l.response_time_ms}ms)`)\n  .join('\\n') || 'none'}\n\nRecent DB events:\n${dbEvents\n  .map(e => `- ${e.created_at} ${e.event_type}: ${e.detail} (${e.duration_ms}ms)`)\n  .join('\\n') || 'none'}\n`;\n\nreturn [\n  {\n    json: {\n      alertId: alert.id,\n      confidence,\n      relatedEvents,\n      evidenceText\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1520,
        176
      ],
      "id": "63860ab3-8fe2-44e8-aeb8-6f834a8ac39f",
